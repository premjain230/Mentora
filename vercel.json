{
  "functions": {
    "functions/*.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/chat",            "destination": "/functions/chat" },
    { "source": "/api/firebase-config", "destination": "/functions/firebase-config" },
    { "source": "/api/generate-plan",   "destination": "/functions/generate-plan" },
    { "source": "/api/replan",          "destination": "/functions/replan" }
  ]
}
