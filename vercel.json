{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/track",
      "destination": "/api/growth?route=track"
    },
    {
      "source": "/api/admin",
      "destination": "/api/growth?route=admin"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/growth?route=admin/$1"
    },
    {
      "source": "/api/cron/growth",
      "destination": "/api/growth?route=cron"
    },
    {
      "source": "/api/recommendations",
      "destination": "/api/learning-event?route=recommendations"
    },
    {
      "source": "/api/arena",
      "destination": "/api/learning-event?route=arena"
    },
    {
      "source": "/api/chat/manage",
      "destination": "/api/learning-event?route=chat-manage"
    },
    {
      "source": "/api/learn-hub",
      "destination": "/api/study-session?route=learn-hub"
    },
    {
      "source": "/api/feedback",
      "destination": "/api/growth?route=feedback"
    },
    {
      "source": "/api/feedback/(.*)",
      "destination": "/api/growth?route=feedback/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/growth",
      "schedule": "0 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mentora.vercel.app"
        }
      ],
      "destination": "https://www.learningallied.world/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mentora-ai.vercel.app"
        }
      ],
      "destination": "https://www.learningallied.world/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mentora-lyart-nine.vercel.app"
        }
      ],
      "destination": "https://www.learningallied.world/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "aquila-sand.vercel.app"
        }
      ],
      "destination": "https://www.learningallied.world/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "aquila-ai.vercel.app"
        }
      ],
      "destination": "https://www.learningallied.world/$1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/how-to-make-a-jee-study-plan.html",
      "destination": "/blog/how-to-make-a-jee-study-plan",
      "permanent": true
    },
    {
      "source": "/:page(about|admin|arena|cbse-board|chat|chat-history|founder|home|jee-preparation|learning-hub|login|maharashtra-board|neet-preparation|onboarding|planner|planner-onboarding|profile|quiz|review|settings|signup|study-session|subscription|verify-email).html",
      "destination": "/:page",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
