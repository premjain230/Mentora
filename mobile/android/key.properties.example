# Copy this file to `mobile/android/key.properties` (git-ignored) and fill in
# your Play Store upload keystore details before running `flutter build appbundle`
# or `flutter build apk --release`.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=../upload-keystore.jks
