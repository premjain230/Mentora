rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function emailMatchesToken() {
      return !('email' in request.resource.data)
        || request.resource.data.email == null
        || (
          request.resource.data.email is string
          && request.resource.data.email.size() <= 320
          && request.auth.token.email != null
          && request.resource.data.email.lower() == request.auth.token.email.lower()
        );
    }

    /* ──────────────────────────────────────────────
       users/{userId}
    ────────────────────────────────────────────── */

    match /users/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid.size() <= 128
        && (
          ('displayName' in request.resource.data && request.resource.data.displayName is string)
          || ('name' in request.resource.data && request.resource.data.name is string)
        )
        && (
          ('displayName' in request.resource.data && request.resource.data.displayName.size() <= 100)
          || ('name' in request.resource.data && request.resource.data.name.size() <= 100)
        )
        // A new self-created profile can never carry entitlement or admin state.
        && (
          !('plan' in request.resource.data)
          || request.resource.data.plan == 'free'
        )
        && (
          !('tier' in request.resource.data)
          || request.resource.data.tier == 'free'
        )
        && (
          !('subscriptionTier' in request.resource.data)
          || request.resource.data.subscriptionTier == 'free'
        )
        && (
          !('subscriptionStatus' in request.resource.data)
          || !(request.resource.data.subscriptionStatus in ['active', 'pro'])
        )
        && (
          !('isPro' in request.resource.data)
          || request.resource.data.isPro != true
        )
        && (
          !('pro' in request.resource.data)
          || request.resource.data.pro != true
        )
        && (
          !('isPremium' in request.resource.data)
          || request.resource.data.isPremium != true
        )
        && (
          !('isAdmin' in request.resource.data)
          || request.resource.data.isAdmin != true
        )
        && (
          !('admin' in request.resource.data)
          || request.resource.data.admin != true
        )
        && (
          !('role' in request.resource.data)
          || (
            request.resource.data.role is string
            && request.resource.data.role.size() <= 60
            && request.resource.data.role.lower() != 'admin'
          )
        )
        && !('subscription' in request.resource.data)
        && !('subscriptionExpiresAt' in request.resource.data)
        && !('proExpiresAt' in request.resource.data)
        && !('proUntil' in request.resource.data)
        && !('referralRewards' in request.resource.data)
        && emailMatchesToken();

      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid',
          'plan',
          'isPro',
          'pro',
          'isPremium',
          'tier',
          'subscriptionTier',
          'subscriptionStatus',
          'subscription',
          'subscriptionExpiresAt',
          'proExpiresAt',
          'proUntil',
          'role',
          'isAdmin',
          'admin',
          'referralRewards'
        ])
        && (!('email' in request.resource.data) || request.resource.data.email == resource.data.email)
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500))
        && (!('exam' in request.resource.data) || (request.resource.data.exam is string && request.resource.data.exam.size() <= 100))
        && (!('studentName' in request.resource.data) || (request.resource.data.studentName is string && request.resource.data.studentName.size() <= 100));

      allow delete: if isOwner(userId);

      /* chats */
      match /chats/{chatId} {

        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200;

        allow update: if isOwner(userId);

        allow delete: if isOwner(userId);

        match /messages/{messageId} {

          allow read: if isOwner(userId);

          allow create: if isOwner(userId)
            && request.resource.data.role in ['user', 'assistant']
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 32000;

          allow update, delete: if false;
        }
      }

      /* quizAttempts */
      match /quizAttempts/{attemptId} {

        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.subject is string
          && request.resource.data.subject.size() <= 100
          && request.resource.data.topic is string
          && request.resource.data.topic.size() <= 200
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 300
          && request.resource.data.totalQ is int
          && request.resource.data.totalQ > 0
          && request.resource.data.totalQ <= 200
          && request.resource.data.correct is int
          && request.resource.data.correct >= 0
          && request.resource.data.correct <= request.resource.data.totalQ
          && request.resource.data.incorrect is int
          && request.resource.data.incorrect >= 0
          && request.resource.data.incorrect <= request.resource.data.totalQ
          && request.resource.data.score is number
          && request.resource.data.maxScore is number
          && request.resource.data.maxScore > 0
          && request.resource.data.takenAt != null;

        allow update: if isOwner(userId);

        allow delete: if isOwner(userId);
      }

      /* dailyQuestions */
      match /dailyQuestions/{questionId} {
        allow read, write: if isOwner(userId);
      }

      /* learning profile */
      match /learning/{doc} {
        allow read, write: if isOwner(userId);
      }

      /* memory cards */
      match /cards/{cardId} {
        allow read, write: if isOwner(userId);
      }

      /* interactions */
      match /interactions/{interactionId} {
        allow read, write: if isOwner(userId);
      }

      /* misconceptions */
      match /misconceptions/{misconceptionId} {
        allow read, write: if isOwner(userId);
      }

      /* analytics subcollection */
      match /analytics/{eventId} {
        allow read, write: if isOwner(userId);
      }

      /* studySessions (legacy) */
      match /studySessions/{sessionId} {

        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.subject is string
          && request.resource.data.subject.size() <= 100
          && request.resource.data.topic is string
          && request.resource.data.topic.size() <= 200
          && request.resource.data.durationMinutes is int
          && request.resource.data.durationMinutes >= 5
          && request.resource.data.durationMinutes <= 480
          && request.resource.data.status in ['active','completed','abandoned'];

        allow update: if isOwner(userId)
          && request.resource.data.status in ['active','completed','abandoned']
          && request.resource.data.subject == resource.data.subject
          && request.resource.data.topic == resource.data.topic
          && request.resource.data.durationMinutes == resource.data.durationMinutes;

        allow delete: if isOwner(userId);
      }

      /* syllabus — real personalisation store */
      match /syllabus/{docId} {
        allow read, write: if isOwner(userId);
      }

      /* planner — onboarding config and generated plans */
      match /planner/{docId} {
        allow read, write: if isOwner(userId);
      }

      /* ── Prompt 4: Real evidence pipeline ──
         learningEvents: append-only, validated type, no update/delete */
      match /learningEvents/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.type is string
          && request.resource.data.type in ['lesson_started','lesson_completed','question_answered','question_correct','question_incorrect','quiz_started','quiz_completed','assessment_completed','hint_requested','explanation_requested','mistake_detected','misconception_detected','topic_reviewed','study_session_started','study_session_completed','goal_created','goal_completed','onboarding_started','onboarding_question_answered','onboarding_answered','onboarding_completed','diagnostic_started','diagnostic_answered','diagnostic_completed','review_started','review_completed','recommendation_clicked','syllabus_uploaded']
          && (!('conceptId' in request.resource.data) || request.resource.data.conceptId == null || (request.resource.data.conceptId is string && request.resource.data.conceptId.size() <= 120))
          && (!('confidence' in request.resource.data) || request.resource.data.confidence == null || (request.resource.data.confidence is number && request.resource.data.confidence >= 1 && request.resource.data.confidence <= 5));
        allow update, delete: if false;
      }

      /* mastery: server-authoritative — clients can read, but not write directly.
         Writes go via POST /api/learning-event (Admin SDK). Until migration is 100%,
         we keep read open, write denied. */
      match /mastery/{conceptId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      /* sessions (unified, new) */
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.subject is string
          && request.resource.data.subject.size() <= 100;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      /* goals subcollection (top-level under user) */
      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 120
          && request.resource.data.uid == request.auth.uid;
        allow update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 120
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isOwner(userId);
      }

      /* diagnostics */
      match /diagnostics/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      /* reviews: server-authoritative V1 — clients read, server writes via Admin SDK */
      match /reviews/{conceptId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      /* recommendations (current) */
      match /recommendations/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      /* ── Arena — server-authoritative progression ──
         Clients READ their own arenaProgress; WRITES go via POST /api/arena (Admin SDK).
         Direct client writes are denied to prevent forged chapter completion / unlock manipulation.
         arenaEvents are append-only audit trail (read owner, no direct write). */
      match /arenaProgress/{subjectKey} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }
      match /arenaEvents/{eventId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    /* ──────────────────────────────────────────────
       entitlements/{userId} — server-owned Pro entitlement

       Written ONLY by trusted server code (Admin SDK): payment webhooks,
       support grants and referral rewards. Clients may read their own record
       so the dashboard can mirror the server's decision, but never write it.
    ────────────────────────────────────────────── */

    match /entitlements/{userId} {

      allow read: if isOwner(userId);

      allow create, update, delete: if false;
    }

    /* ──────────────────────────────────────────────
       usage
    ────────────────────────────────────────────── */

    match /usage/{userId} {

      allow read: if isOwner(userId);

      // Usage counters are owned by server-side functions (Admin SDK bypasses
      // these rules). Browsers may only READ usage, so a user can never reset
      // their own limits by editing this document from DevTools.
      allow create, update, delete: if false;
    }

    /* ──────────────────────────────────────────────
       proRequests
    ────────────────────────────────────────────── */

    match /proRequests/{userId} {

      // A request is an immutable "please upgrade me" signal. It can never
      // carry an approval/status change or arbitrary extra fields.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'contactEmail',
          'contactName',
          'message',
          'requestedAt',
          'status'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && (
          request.auth.token.email == null
          || request.resource.data.email.lower() == request.auth.token.email.lower()
        )
        && (
          !('contactEmail' in request.resource.data)
          || (
            request.resource.data.contactEmail is string
            && request.resource.data.contactEmail.size() <= 320
          )
        )
        && (
          !('contactName' in request.resource.data)
          || (
            request.resource.data.contactName is string
            && request.resource.data.contactName.size() <= 100
          )
        )
        && (
          !('message' in request.resource.data)
          || (
            request.resource.data.message is string
            && request.resource.data.message.size() <= 2000
          )
        );

      allow read: if isOwner(userId);

      allow update, delete: if false;
    }

    /* ──────────────────────────────────────────────
       studyPlans
    ────────────────────────────────────────────── */

    match /studyPlans/{planId} {

      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.status in ['active','archived','completed'];

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    /* ──────────────────────────────────────────────
       tasks
    ────────────────────────────────────────────── */

    match /tasks/{taskId} {

      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in
          ['pending','completed','skipped','rescheduled']
        && request.resource.data.durationMinutes is number
        && request.resource.data.durationMinutes >= 5
        && request.resource.data.durationMinutes <= 480
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 100
        && request.resource.data.topic is string
        && request.resource.data.topic.size() <= 200;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.status in
          ['pending','completed','skipped','rescheduled'];

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    /* ──────────────────────────────────────────────
       progress
    ────────────────────────────────────────────── */

    match /progress/{userId} {

      allow read: if isOwner(userId);

      allow write: if isOwner(userId);
    }

    /* ──────────────────────────────────────────────
       analytics/{userId}/events
    ────────────────────────────────────────────── */

    match /analytics/{userId}/events/{eventId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 50;

      allow update, delete: if false;
    }

    /* ──────────────────────────────────────────────
       support_requests
    ────────────────────────────────────────────── */

    match /support_requests/{docId} {

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.message.size() > 0
        && request.resource.data.subject.size() <= 100
        && request.resource.data.message.size() <= 1000;

      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow update, delete: if false;
    }

    /* ──────────────────────────────────────────────
       beyondMarks — dreams
    ────────────────────────────────────────────── */

    match /dreams/{doc} {

      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 120
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if false;
    }

    /* ──────────────────────────────────────────────
       beyondMarks — stories
    ────────────────────────────────────────────── */

    match /stories/{doc} {

      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 100
        && request.resource.data.category is string
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 5000
        && request.resource.data.readingTime is number
        && request.resource.data.reactions is number
        && request.resource.data.comments is number
        && request.resource.data.bookmarks is number;

      allow update: if isSignedIn()
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.category == resource.data.category;

      allow delete: if false;

      match /comments/{commentId} {

        allow read: if true;

        allow create: if isSignedIn()
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 200
          && request.resource.data.uid == request.auth.uid;

        allow update, delete: if false;
      }
    }

    /* ──────────────────────────────────────────────
       beyondMarks — legacyTrees
    ────────────────────────────────────────────── */

    match /legacyTrees/{userId} {

      allow read: if isOwner(userId);

      allow write: if isOwner(userId)
        && request.resource.data.stage is number
        && request.resource.data.stage >= 0 && request.resource.data.stage <= 20
        && request.resource.data.xp is number
        && request.resource.data.xp >= 0 && request.resource.data.xp <= 1000000
        && request.resource.data.uid == request.auth.uid;
    }

    /* ──────────────────────────────────────────────
       referralCodes — managed server-side only (service account)
    ────────────────────────────────────────────── */

    match /referralCodes/{code} {
      allow read, write: if false;
    }

    /* ──────────────────────────────────────────────
       referrals — managed server-side only (service account)
    ────────────────────────────────────────────── */

    match /referrals/{referralId} {
      allow read, write: if false;
    }

    /* ──────────────────────────────────────────────
       Growth Agent — server-side only collections.
       Clients never read/write these directly; the Vercel
       functions use the service account (admin SDK).
    ────────────────────────────────────────────── */

    match /growth_events/{eventId} {
      allow read, write: if false;
    }

    match /growth_reports/{doc} {
      allow read, write: if false;
    }

    match /growth_content/{cid} {
      allow read, write: if false;
    }

    match /growth_settings/{doc} {
      allow read, write: if false;
    }

    /* ──────────────────────────────────────────────
       Default deny
    ────────────────────────────────────────────── */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
