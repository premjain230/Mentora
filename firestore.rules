rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================
    // HELPERS
    // =========================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // =========================
    // USERS
    // =========================

    match /users/{userId} {

      allow read: if isSignedIn();

      allow create: if isOwner(userId);

      allow update: if (
        isOwner(userId)
        ||
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'followers',
            'following',
            'connections',
            'pendingConnections',
            'sentConnections',
            'photoURL',
            'bannerURL'
          ])
      );

      allow delete: if isOwner(userId);
    }

    // =========================
    // POSTS
    // =========================

    match /posts/{postId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isSignedIn();

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // =========================
    // CONVERSATIONS
    // =========================

    match /conversations/{conversationId} {

      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;

      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow delete: if false;
    }

    // =========================
    // TOP LEVEL MESSAGES
    // =========================

    match /messages/{messageId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid;

      allow update: if isSignedIn();

      allow delete: if isSignedIn()
        && resource.data.fromUid == request.auth.uid;
    }

    // =========================
    // NOTIFICATIONS
    // =========================

    match /notifications/{notificationId} {

      allow read: if isSignedIn()
        && resource.data.toUid == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.toUid == request.auth.uid;

      allow delete: if isSignedIn()
        && (
          resource.data.toUid == request.auth.uid
          || resource.data.fromUid == request.auth.uid
        );
    }

    // =========================
    // INVOICES (legacy)
    // =========================

    match /invoices/{invoice} {
      allow read, write: if isSignedIn();
    }

    // =========================
    // COMMUNITY BOARD — POSTS
    // =========================

    match /community_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid;
        allow update: if isSignedIn()
          && resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn()
          && resource.data.authorId == request.auth.uid;
      }
    }

    // =========================
    // COMMUNITY BOARD — VOTES
    // =========================

    match /community_votes/{voteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      // allow update to re-vote
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // =========================
    // EXAM NEWS (AI-curated)
    // =========================

    match /exam_news/{newsId} {
      allow read: if isSignedIn();
      // Only admin/server can write — disable client writes
      allow create, update, delete: if false;
    }

    // =========================
    // LEGACY COLLECTIONS
    // =========================

    match /dreams/{doc} {
      allow read, write: if isSignedIn();
    }

    match /stories/{doc} {
      allow read, write: if isSignedIn();
    }

    match /dailyReflections/{doc} {
      allow read, write: if isSignedIn();
    }

    match /support_requests/{doc} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn();
    }

    // =========================
    // DEFAULT DENY
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
