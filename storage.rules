rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User syllabus uploads — only owner can read/write their own folder
    match /users/{userId}/syllabus/{fileId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && request.resource.size < 8 * 1024 * 1024
                         && request.resource.contentType.matches('application/pdf|image/.*');
    }
    // Allow listing own syllabus folder
    match /users/{userId}/syllabus/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    // Legacy fallback — deny by default, explicit deny for other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
